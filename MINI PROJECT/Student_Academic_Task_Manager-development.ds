 application "Student Academic Task Manager"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form Attendence
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form student_profile
		{
			displayname = "Student Profile"
			success message = "Student Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			student_name
			(
    			type = name
				displayname = "Student Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			student_code
			(
    			type = text
				displayname = "Student Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			enrollment_date
			(
    			type = date
				displayname = "Enrollment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			current_semester
			(
				type = number
				displayname = "Current Semester"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			major
			(
    			type = text
				displayname = "Major"
	 			row = 1
	 			column = 1   
				width = medium
			)
			gpa
			(
				type = decimal
				displayname = "GPA"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			role
			(
				type = radiobuttons
				displayname = "Role"
				values = {"Administrator","Student"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Active","Inactive","Graduated"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Student Draft","Submitted","Active"}
			}
		}
		form subject1
		{
			displayname = "Subject"
			success message = "Subject Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			subject_code
			(
    			type = text
				displayname = "Subject Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			subject_name
			(
    			type = text
				displayname = "Subject Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			credits
			(
				type = number
				displayname = "Credits"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			semester
			(
				type = number
				displayname = "Semester"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			instructor
			(
    			type = name
				displayname = "Instructor Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_number
			(
    			type = text
				displayname = "Room Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			schedule
			(
    			type = text
				displayname = "Schedule"
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = radiobuttons
				displayname = "Status"
				values = {"Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Stage1","Stage2","Stage3"}
			}
		}
		form task
		{
			displayname = "Task"
			success message = "Task Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			task_title
			(
    			type = text
				displayname = "Task Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			task_code
			(
    			type = text
				displayname = "Task Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			due_date
			(
    			type = date
				displayname = "Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			priority
			(
				type = picklist
				displayname = "Priority"
				values = {"High","Low","Medium","Critical"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			estimated_hours
			(
				type = number
				displayname = "Estimated Hours"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			actual_hours
			(
				type = number
				displayname = "Actual Hours"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			file_url
			(
    			type = url
				displayname = "File URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Completed","In Progress","Overdue","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_by
			(
    			type = text
				displayname = "Created By"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Task Created","Task Pending Review","Task Draft","Task Cancelled","Task Approved","Task Rejected","Task In Progress","Task On Hold","Task Completed","Task Closed","start"}
			}
		}
		form task_progress
		{
			displayname = "Task Progress"
			success message = "Task Progress Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			progress_title
			(
    			type = text
				displayname = "Progress Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			progress_code
			(
    			type = text
				displayname = "Progress Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			task
			(
				type = list	
				displayname = "Task"
				values  = task.ID
    			displayformat = [task_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			progress_date
			(
    			type = date
				displayname = "Progress Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			update_description
			(
    			type = textarea
				displayname = "Update Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			hours_spent
			(
				type = number
				displayname = "Hours Spent"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			completion_percentage
			(
    			type = percentage
				displayname = "Completion Percentage"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			next_milestone
			(
    			type = text
				displayname = "Next Milestone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			attachments
			(
    			type = textarea
				displayname = "Attachments"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Stage1","Stage2","Stage3"}
			}
		}
		form task_subject
		{
			displayname = "Task Subject"
			success message = "Task Subject Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			task
			(
				type = list	
				displayname = "Task"
				values  = task.ID
    			displayformat = [task_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			subject_1
			(
				type = list	
				displayname = "Subject"
				values  = subject1.ID
    			displayformat = [subject_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			assignment_type
			(
				type = picklist
				displayname = "Assignment Type"
				values = {"Project","Quiz","Lab","Exam","Homework"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			weightage
			(
    			type = percentage
				displayname = "Weightage"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)

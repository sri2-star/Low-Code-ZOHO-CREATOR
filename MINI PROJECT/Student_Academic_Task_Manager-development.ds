				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Assignment Created","Assignment Pending Review","Assignment Draft","Assignment Approved","Assignment Rejected","Assignment Active","Assignment Completed","Assignment On Hold","Assignment Cancelled","Assignment Archived"}
			}
		}
	}
	reports
	{
		list task_subject_Report
		{
			displayName = "All Task Subjects"
			show all rows from task_subject    
			(
				task as "Task"
				subject_1 as "Subject"
				assignment_type as "Assignment Type"
				weightage as "Weightage"
				(
					display = total,average,min,max	
				)
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (assignment_type == "Homework")
				fields = [assignment_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (assignment_type == "Lab")
				fields = [assignment_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (assignment_type == "Project")
				fields = [assignment_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban task_subject_by_assignment_type
		{
			displayName = "Assignment Types"
			show all rows from task_subject    
			(
				task as "Task"
				subject_1 as "Subject"
				(
					view = subject1_Report
					delimiter = comma
				)
				assignment_type as "Assignment Type"
				weightage as "Weightage"
				(
					display = total,average,min,max	
				)
			)
			options
			(
	 			display field = assignment_type
				filter type  = manual
				sort order  = ascending
				record count  = enable
	 		)
		}
		list task_progress_Report
		{
			displayName = "All Task Progress"
			show all rows from task_progress    
			(
				progress_title as "Progress Title"
				progress_code as "Progress Code"
				task as "Task"
				progress_date as "Progress Date"
				update_description as "Update Description"
				hours_spent as "Hours Spent"
				completion_percentage as "Completion Percentage"
				(
					display = total,average,min,max	
				)
				next_milestone as "Next Milestone"
				attachments as "Attachments"
			)
		}
		list task_Report
		{
			displayName = "All Tasks"
			show all rows from task    
			(
				task_title as "Task Title"
				task_code as "Task Code"
				description as "Description"
				due_date as "Due Date"
				priority as "Priority"
				estimated_hours as "Estimated Hours"
				actual_hours as "Actual Hours"
				file_url as "File URL"
				status as "Status"
				created_by as "Created By"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (priority == "Critical")
				fields = [priority]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (priority == "Low")
				fields = [priority]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (priority == "Medium")
				fields = [priority]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban task_by_priority
		{
			displayName = "Priorities"
			show all rows from task    
			(
				task_title as "Task Title"
				task_code as "Task Code"
				description as "Description"
				due_date as "Due Date"
				priority as "Priority"
				estimated_hours as "Estimated Hours"
				actual_hours as "Actual Hours"
				file_url as "File URL"
				status as "Status"
				created_by as "Created By"
			)
			options
			(
	 			display field = priority
	 		)
		}
		list subject1_Report
		{
			displayName = "All Subjects"
			show all rows from subject1    
			(
				subject_code as "Subject Code"
				subject_name as "Subject Name"
				credits as "Credits"
				semester as "Semester"
				instructor  as "Instructor Name"
				room_number as "Room Number"
				schedule as "Schedule"
				description as "Description"
				status as "Status"
			)
		}
		list student_profile_Report
		{
			displayName = "All Student Profiles"
			show all rows from student_profile    
			(
				student_name  as "Student Name"
				student_code as "Student Code"
				email as "Email Address"
				phone_number as "Phone Number"
				enrollment_date as "Enrollment Date"
				current_semester as "Current Semester"
				major as "Major"
				gpa as "GPA"
				role as "Role"
				status as "Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Active")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Graduated")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "Inactive")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban student_profile_by_status
		{
			displayName = "Statuses"
			show all rows from student_profile    
			(
				student_name  as "Student Name"
				student_code as "Student Code"
				email as "Email Address"
				phone_number as "Phone Number"
				enrollment_date as "Enrollment Date"
				current_semester as "Current Semester"
				major as "Major"
				gpa as "GPA"
				role as "Role"
				status as "Status"
			)
			options
			(
	 			display field = status
				sort order  = ascending
	 		)
		}
		default list Attendence_Report
		{
			displayName = "Attendence Report"
			show all rows from Attendence    
			(
				Name 
			)
		}
		list All_Tasks
		{
			displayName = "All Tasks"
			show all rows from task  [status == "Completed"]  
			(
				task_title as "Task Title"
				task_code as "Task Code"
				description as "Description"
				due_date as "Due Date"
				priority as "Priority"
				estimated_hours as "Estimated Hours"
				actual_hours as "Actual Hours"
				file_url as "File URL"
				status as "Status"
				created_by as "Created By"
			)
		}
		list Pending_Tasks
		{
			displayName = "Pending Tasks"
			show all rows from task  [status == "Pending"]  
			(
				task_title as "Task Title"
				task_code as "Task Code"
				description as "Description"
				due_date as "Due Date"
				priority as "Priority"
				estimated_hours as "Estimated Hours"
				actual_hours as "Actual Hours"
				file_url as "File URL"
				status as "Status"
				created_by as "Created By"
			)
			conditional formatting
			(
				"new"
				{
				fields = [task_title]
				format = "color:#333;"
				}
			)
		}
	}

		workflow
		{
		form
		{
			notify_high_priority_task as "Notify Student on High Priority Task"
			{
				type =  form
				form = task

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Check if the task priority is High
										if(input.priority == "High")
										{
											// Send push notification to the logged-in user
											// Required parameters: emailID, title, message, reportLinkName, recordID
											zoho.pushNotification(zoho.loginuserid,"High Priority Task Created","A new high priority task has been created: " + input.task_title,"task",input.ID);
										}
						)
					}
				}

			}
			validate_task_hours as "Validate Task Hours Before Submission"
			{
				type =  form
				form = task

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate estimated hours before allowing form submission
										if(input.estimated_hours > 100)
										{
											alert(estimated_hours,"Estimated hours cannot exceed 100. Please adjust the value.");
											cancel submit;
										}
						)
					}
				}

			}
			show_project_details as "Show Extra Details for Projects"
			{
				type =  form
				form = task_subject

				record event = on edit

				on user input of assignment_type
				{
					actions 
					{
						custom deluge script
						(
											// Show assignment type field only when project is selected in assignment_type field
										if(input.assignment_type == "Project")
										{
											show assignment_type;
										}
										else
										{
											hide assignment_type;
										}
						)
					}
				}

			}
			Student_Profile as "Student Profile"
			{
				type =  form
				form = student_profile

				record event = on add or edit

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "srinithikannan23012007@gmail.com"
							subject : "Record Added or Updated${zoho.adminuserid}${status}"
							message : "<div>${zoho.loginuserid} has added or updated a record in form Student Profile<br></div>"
						)
					}
				}

			}
		}

		schedule
		{
			auto_set_task_status as "Auto-set Task Status on Due Date"
			{
				type =  schedule
				form = task
					status = inactive
				start = due_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch the current task record from input context
										if(input.due_date.isNull() || input.status == "Completed")
										{
											// Skip if no due date or already completed
											info "Task does not require overdue update";
										}
										else
										{
											// Get current date
											currentDate = today;
											// Check if due date has passed
											if(input.due_date < currentDate)
											{
												// Update task status to Overdue
												input.status = "Overdue";
												// Send notification email
												sendmail
												[
													from :zoho.loginuserid
													to :input.created_by
													subject :"Task Overdue Notification"
													message :"<p>Dear User,</p><p>The task <strong>" + input.task_title + "</strong> is now marked as Overdue as the due date <strong>" + input.due_date.toString() + "</strong> has passed.</p><p>Please complete the task at the earliest.</p>"
												]
											}
										}
					)
					}
				}
			}
		}


